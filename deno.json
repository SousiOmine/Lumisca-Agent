{
  "workspace": [
    "packages/core",
    "packages/server",
    "packages/cli",
    "packages/web"
  ],
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "npm:@types/react@19",
    "lib": ["esnext", "dom", "dom.iterable", "deno.ns", "deno.window"]
  },
  "imports": {
    "react": "npm:react@19.2.3",
    "react-dom": "npm:react-dom@19.2.3",
    "react-dom/client": "npm:react-dom@19.2.3/client",
    "react-dom/server": "npm:react-dom@19.2.3/server",
    "@types/react": "npm:@types/react@19",
    "@tabler/icons-react": "npm:@tabler/icons-react@3",
    "marked": "npm:marked@15",
    "esbuild": "npm:esbuild@0.25.12",
    "@std/assert": "jsr:@std/assert@1",
    "@earendil-works/pi-ai": "npm:@earendil-works/pi-ai@0.83.0",
    "@earendil-works/pi-ai/providers/all": "npm:@earendil-works/pi-ai@0.83.0/providers/all",
    "@earendil-works/pi-agent-core": "npm:@earendil-works/pi-agent-core@0.83.0",
    "hono": "npm:hono@4",
    "hono/cors": "npm:hono@4/cors",
    "hono/deno": "npm:hono@4/deno"
  },
  "fmt": {
    "exclude": [
      "**/*.svg",
      "**/*.html",
      "**/*.md",
      "packages/desktop/src-tauri/icons",
      ".lumisca-cache",
      ".playwright-mcp"
    ]
  },
  "tasks": {
    "check": "deno check packages/core/mod.ts packages/server/mod.ts packages/cli/mod.ts packages/web/src/client.tsx",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "test": "deno test packages/core packages/server packages/cli packages/web --allow-read --allow-write --allow-run --allow-env --allow-net",
    "test:watch": "deno test --watch packages/core packages/server packages/cli packages/web --allow-read --allow-write --allow-run --allow-env --allow-net",
    "server": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run --allow-sys packages/server/mod.ts",
    "server:dev": "LUMISCA_DEV=1 deno run --allow-net --allow-read --allow-write --allow-env --allow-run --allow-sys packages/server/mod.ts",
    "cli": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run --allow-sys packages/cli/mod.ts"
  }
}
