{
  "workspace": [
    "packages/core",
    "packages/server",
    "packages/web"
  ],
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["esnext", "dom", "dom.iterable", "deno.ns", "deno.window"]
  },
  "imports": {
    "@ai-sdk/amazon-bedrock": "npm:@ai-sdk/amazon-bedrock@5.0.105",
    "@ai-sdk/anthropic": "npm:@ai-sdk/anthropic@4.0.71",
    "@ai-sdk/azure": "npm:@ai-sdk/azure@4.0.90",
    "@ai-sdk/google": "npm:@ai-sdk/google@4.0.87",
    "@ai-sdk/mistral": "npm:@ai-sdk/mistral@4.0.56",
    "@ai-sdk/openai": "npm:@ai-sdk/openai@4.0.83",
    "@ai-sdk/openai-compatible": "npm:@ai-sdk/openai-compatible@3.0.62",
    "@opencode-ai/models": "npm:@opencode-ai/models@0.0.81",
    "@opencode-ai/models/snapshot": "npm:@opencode-ai/models@0.0.81/snapshot",
    "@std/jsonc": "jsr:@std/jsonc@1.0.3",
    "@std/yaml": "jsr:@std/yaml@1.3.0",
    "@std/tar": "jsr:@std/tar@0.1.10",
    "@noble/hashes/blake2.js": "jsr:@noble/hashes@2.4.0/blake2.js",
    "ai": "npm:ai@7.0.127",
    "preact": "npm:preact@11.0.0",
    "preact/compat": "npm:preact@11.0.0/compat",
    "preact/compat/client": "npm:preact@11.0.0/compat/client",
    "preact/jsx-runtime": "npm:preact@11.0.0/jsx-runtime",
    "preact-render-to-string": "npm:preact-render-to-string@6.8.0",
    "@tabler/icons-preact": "npm:@tabler/icons-preact@3.48.0",
    "marked": "npm:marked@18.0.14",
    "esbuild": "npm:esbuild@0.28.2",
    "sucrase": "npm:sucrase@3.35.1",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "unpdf": "npm:unpdf@1.8.1",
    "@napi-rs/canvas": "npm:@napi-rs/canvas@1.0.10",
    "@modelcontextprotocol/sdk/client/auth.js": "npm:@modelcontextprotocol/sdk@1.32.0/client/auth.js",
    "@modelcontextprotocol/sdk/client/index.js": "npm:@modelcontextprotocol/sdk@1.32.0/client/index.js",
    "@modelcontextprotocol/sdk/client/stdio.js": "npm:@modelcontextprotocol/sdk@1.32.0/client/stdio.js",
    "@modelcontextprotocol/sdk/client/streamableHttp.js": "npm:@modelcontextprotocol/sdk@1.32.0/client/streamableHttp.js",
    "@modelcontextprotocol/sdk/shared/auth.js": "npm:@modelcontextprotocol/sdk@1.32.0/shared/auth.js",
    "hono": "npm:hono@4.13.13",
    "hono/cookie": "npm:hono@4.13.13/cookie",
    "hono/cors": "npm:hono@4.13.13/cors",
    "hono/deno": "npm:hono@4.13.13/deno",
    "hono/http-status": "npm:hono@4.13.13/utils/http-status"
  },
  "fmt": {
    "exclude": [
      "**/*.svg",
      "**/*.html",
      "**/*.md",
      "packages/desktop/src-tauri/icons",
      ".lumisca-cache",
      ".playwright-mcp"
    ]
  },
  "tasks": {
    "check": "deno check packages/core/mod.ts packages/server/mod.ts packages/web/src/client.tsx packages/web/vite.config.ts scripts/*.ts",
    "check:versions": "deno run --allow-read scripts/check-versions.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "test": "deno test --parallel packages/core packages/server packages/web --allow-read --allow-write --allow-run --allow-env --allow-net --allow-ffi --allow-sys",
    "test:watch": "deno test --parallel --watch packages/core packages/server packages/web --allow-read --allow-write --allow-run --allow-env --allow-net --allow-ffi --allow-sys",
    "build:server": "deno run --allow-all scripts/build-server.ts",
    "smoke:server": "deno run --allow-all scripts/smoke-server.ts",
    "dev": {
      "dependencies": ["dev:server", "dev:web"]
    },
    "dev:desktop": "deno run --allow-env --allow-run packages/desktop/scripts/dev.ts",
    "dev:server": "deno task server",
    "dev:web": "deno task --filter @lumisca/web dev",
    "server": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run --allow-sys --allow-ffi packages/server/mod.ts"
  }
}
