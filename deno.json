{
  "workspace": [
    "packages/core",
    "packages/server",
    "packages/cli",
    "packages/web"
  ],
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["esnext", "dom", "dom.iterable", "deno.ns", "deno.window"]
  },
  "imports": {
    "@ai-sdk/amazon-bedrock": "npm:@ai-sdk/amazon-bedrock@5.0.81",
    "@ai-sdk/anthropic": "npm:@ai-sdk/anthropic@4.0.52",
    "@ai-sdk/azure": "npm:@ai-sdk/azure@4.0.68",
    "@ai-sdk/google": "npm:@ai-sdk/google@4.0.67",
    "@ai-sdk/mistral": "npm:@ai-sdk/mistral@4.0.42",
    "@ai-sdk/openai": "npm:@ai-sdk/openai@4.0.65",
    "@ai-sdk/openai-compatible": "npm:@ai-sdk/openai-compatible@3.0.47",
    "@opencode-ai/models": "npm:@opencode-ai/models@0.0.67",
    "@opencode-ai/models/snapshot": "npm:@opencode-ai/models@0.0.67/snapshot",
    "@std/jsonc": "jsr:@std/jsonc@^1.0.2",
    "@std/yaml": "jsr:@std/yaml@^1.2.0",
    "ai": "npm:ai@7.0.97",
    "preact": "npm:preact@10.29.8",
    "preact/compat": "npm:preact@10.29.8/compat",
    "preact/compat/client": "npm:preact@10.29.8/compat/client",
    "preact/jsx-runtime": "npm:preact@10.29.8/jsx-runtime",
    "preact-render-to-string": "npm:preact-render-to-string@6.7.0",
    "@tabler/icons-preact": "npm:@tabler/icons-preact@^3.46.0",
    "marked": "npm:marked@^18.0.12",
    "esbuild": "npm:esbuild@0.28.2",
    "sucrase": "npm:sucrase@3.35.1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "unpdf": "npm:unpdf@1.8.1",
    "@napi-rs/canvas": "npm:@napi-rs/canvas@1.0.9",
    "@modelcontextprotocol/sdk/client/index.js": "npm:@modelcontextprotocol/sdk@1.30.0/client/index.js",
    "@modelcontextprotocol/sdk/client/stdio.js": "npm:@modelcontextprotocol/sdk@1.30.0/client/stdio.js",
    "@modelcontextprotocol/sdk/client/streamableHttp.js": "npm:@modelcontextprotocol/sdk@1.30.0/client/streamableHttp.js",
    "hono": "npm:hono@^4.13.7",
    "hono/cors": "npm:hono@^4.13.7/cors",
    "hono/deno": "npm:hono@^4.13.7/deno",
    "hono/http-status": "npm:hono@^4.13.7/utils/http-status"
  },
  "fmt": {
    "exclude": [
      "**/*.svg",
      "**/*.html",
      "**/*.md",
      "packages/desktop/src-tauri/icons",
      ".lumisca-cache",
      ".playwright-mcp"
    ]
  },
  "tasks": {
    "check": "deno check packages/core/mod.ts packages/server/mod.ts packages/cli/mod.ts packages/web/src/client.tsx",
    "check:versions": "deno run --allow-read scripts/check-versions.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "test": "deno test packages/core packages/server packages/cli packages/web --allow-read --allow-write --allow-run --allow-env --allow-net --allow-ffi --allow-sys",
    "test:watch": "deno test --watch packages/core packages/server packages/cli packages/web --allow-read --allow-write --allow-run --allow-env --allow-net --allow-ffi --allow-sys",
    "dev": {
      "dependencies": ["dev:server", "dev:web"]
    },
    "dev:desktop": "deno run --allow-env --allow-run packages/desktop/scripts/dev.ts",
    "dev:server": "deno task server",
    "dev:web": "deno task --filter @lumisca/web dev",
    "server": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run --allow-sys --allow-ffi packages/server/mod.ts",
    "cli": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run --allow-sys --allow-ffi packages/cli/mod.ts"
  }
}
