{
  "workspace": [
    "packages/core",
    "packages/server",
    "packages/cli",
    "packages/web"
  ],
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "npm:@types/react@19",
    "lib": ["esnext", "dom", "dom.iterable", "deno.ns", "deno.window"]
  },
  "imports": {
    "@std/yaml": "jsr:@std/yaml@^1.2.0",
    "react": "npm:react@19.2.8",
    "react-dom": "npm:react-dom@19.2.8",
    "react-dom/client": "npm:react-dom@19.2.8/client",
    "react-dom/server": "npm:react-dom@19.2.8/server",
    "@types/react": "npm:@types/react@19",
    "@tabler/icons-react": "npm:@tabler/icons-react@3",
    "marked": "npm:marked@18",
    "esbuild": "npm:esbuild@0.28.2",
    "sucrase": "npm:sucrase@3.35.1",
    "@std/assert": "jsr:@std/assert@1",
    "@earendil-works/pi-ai": "npm:@earendil-works/pi-ai@0.84.1",
    "@earendil-works/pi-ai/providers/all": "npm:@earendil-works/pi-ai@0.84.1/providers/all",
    "@earendil-works/pi-agent-core": "npm:@earendil-works/pi-agent-core@0.84.1",
    "@modelcontextprotocol/sdk/client/index.js": "npm:@modelcontextprotocol/sdk@1.30.0/client/index.js",
    "@modelcontextprotocol/sdk/client/stdio.js": "npm:@modelcontextprotocol/sdk@1.30.0/client/stdio.js",
    "@modelcontextprotocol/sdk/client/streamableHttp.js": "npm:@modelcontextprotocol/sdk@1.30.0/client/streamableHttp.js",
    "hono": "npm:hono@4",
    "hono/cors": "npm:hono@4/cors",
    "hono/deno": "npm:hono@4/deno"
  },
  "fmt": {
    "exclude": [
      "**/*.svg",
      "**/*.html",
      "**/*.md",
      "packages/desktop/src-tauri/icons",
      ".lumisca-cache",
      ".playwright-mcp"
    ]
  },
  "tasks": {
    "check": "deno check packages/core/mod.ts packages/server/mod.ts packages/cli/mod.ts packages/web/src/client.tsx",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "test": "deno test packages/core packages/server packages/cli packages/web --allow-read --allow-write --allow-run --allow-env --allow-net",
    "test:watch": "deno test --watch packages/core packages/server packages/cli packages/web --allow-read --allow-write --allow-run --allow-env --allow-net",
    "dev": {
      "dependencies": ["dev:server", "dev:web"]
    },
    "dev:server": "deno task server",
    "dev:web": "deno task --filter @lumisca/web dev",
    "server": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run --allow-sys --allow-ffi packages/server/mod.ts",
    "cli": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run --allow-sys packages/cli/mod.ts"
  }
}
