{
  "name": "lumisca-agent",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.146",
    "@ai-sdk/anthropic": "4.0.107",
    "@ai-sdk/azure": "4.0.130",
    "@ai-sdk/google": "4.0.124",
    "@ai-sdk/mistral": "4.0.89",
    "@ai-sdk/openai": "4.0.122",
    "@ai-sdk/openai-compatible": "3.0.94",
    "@jellybrick/dbus-next": "0.11.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/canvas": "1.2.0",
    "@noble/hashes": "2.4.0",
    "@novnc/novnc": "1.7.0",
    "@opencode-ai/models": "0.0.143",
    "@std/jsonc": "npm:@jsr/std__jsonc@1.0.3",
    "@std/tar": "npm:@jsr/std__tar@0.1.10",
    "@std/yaml": "npm:@jsr/std__yaml@1.3.0",
    "@tabler/icons-preact": "3.52.0",
    "ai": "7.0.179",
    "esbuild": "0.28.2",
    "hono": "4.13.21",
    "jose": "6.2.18",
    "katex": "0.19.1",
    "marked": "18.2.1",
    "motion": "14.14.0",
    "preact": "11.2.0",
    "sucrase": "3.35.1",
    "unpdf": "2.2.1",
    "zod": "4.6.7"
  },
  "scripts": {
    "build:server": "bun run scripts/build-server.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "check:tests": "tsc -p tsconfig.test.json",
    "check:arch": "bun run scripts/check-architecture.ts",
    "check:i18n": "bun run scripts/check-ui-keys.ts",
    "check:ja": "bun run scripts/check-ui-japanese.ts",
    "check:versions": "bun run scripts/check-versions.ts",
    "demo": "bun run scripts/demo-server.ts",
    "dev": "bun run scripts/dev.ts",
    "dev:desktop": "bun run packages/desktop/scripts/dev.ts",
    "dev:server": "bun run packages/server/mod.ts",
    "fmt": "biome check --write .",
    "fmt:check": "biome check .",
    "probe:computer": "bun run scripts/probe-computer.ts",
    "probe:share": "bun run scripts/probe-share.ts",
    "probe:stella": "bun run scripts/probe-stella.ts",
    "probe:token": "bun run scripts/token-probe.ts",
    "seed:history": "bun run scripts/seed-test-history.ts",
    "server": "bun run packages/server/mod.ts",
    "smoke:server": "bun run scripts/smoke-server.ts",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun run scripts/test-suite.ts unit",
    "test:integration": "bun run scripts/test-suite.ts integration",
    "test:serial": "bun run scripts/test-suite.ts integration --serial",
    "test:coverage": "bun test --coverage --parallel --timeout 30000",
    "measure": "bun run scripts/measure.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@std/assert": "npm:@jsr/std__assert@1.0.19",
    "@types/node": "26.6.6",
    "preact-render-to-string": "6.8.3",
    "typescript": "^7.0.2"
  }
}
