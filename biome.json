{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!packages/desktop/src-tauri/icons",
      "!**/*.md",
      "!**/*.svg",
      "!**/*.html"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noAssignInExpressions": "off",
        "noDoubleEquals": "off",
        "noThenProperty": "off",
        "noProto": "off",
        "noFallthroughSwitchClause": "off",
        "noTemplateCurlyInString": "off",
        "useIterableCallbackReturn": "off",
        "noControlCharactersInRegex": "off",
        "noLabelVar": "off",
        "noExplicitAny": "off"
      },
      "complexity": {
        "noCommaOperator": "off",
        "useOptionalChain": "off",
        "useLiteralKeys": "off",
        "useMathMinMax": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        "noDescendingSpecificity": "off"
      },
      "correctness": {
        "noInnerDeclarations": "off",
        "noUnusedFunctionParameters": "off",
        "noUnusedVariables": "error"
      },
      "a11y": {
        "recommended": false
      }
    }
  }
}
