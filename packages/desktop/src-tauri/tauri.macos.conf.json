{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lumisca",
        "width": 1280,
        "height": 860,
        "minWidth": 360,
        "minHeight": 480,
        "backgroundColor": "#0c0c11",
        "create": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/32x32.png"
    ],
    "resources": {
      "resources/server/lumisca-server": "server/lumisca-server",
      "resources/server/stella-container": "server/stella-container"
    }
  }
}
