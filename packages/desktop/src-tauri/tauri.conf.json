{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumisca",
  "version": "0.2.2",
  "identifier": "com.lumisca.agent",
  "build": {
    "frontendDist": "./frontend",
    "beforeDevCommand": {
      "script": "npm run build:server:dev",
      "cwd": ".."
    },
    "beforeBuildCommand": {
      "script": "npm run build:server",
      "cwd": ".."
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lumisca",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600,
        "backgroundColor": "#1b1b1b",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* http://lumisca.localhost; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNENzdENTM2N0Y1NENBRjEKUldUeHlsUi9OdFYzUGJuZERCc3paSjRBaXY1VDFkelVJR1VUM3Fkei9NMHdlUmxuWmNwcFU5bmgK",
      "endpoints": [
        "https://github.com/SousiOmine/Lumisca-Agent/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "resources": {
      "resources/server/assets.json": "server/assets.json",
      "resources/server/lumisca-server.exe": "server/lumisca-server.exe"
    }
  }
}
