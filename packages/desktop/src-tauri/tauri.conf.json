{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumisca",
  "version": "0.1.0",
  "identifier": "com.lumisca.agent",
  "build": {
    "frontendDist": "./frontend",
    "beforeDevCommand": {
      "script": "npm run build:server:dev",
      "cwd": ".."
    },
    "beforeBuildCommand": {
      "script": "npm run build:server",
      "cwd": ".."
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lumisca",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "resources": {
      "resources/server/assets.json": "server/assets.json",
      "resources/server/lumisca-server.exe": "server/lumisca-server.exe"
    }
  }
}
