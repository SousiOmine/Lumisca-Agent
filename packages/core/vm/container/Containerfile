# The stella virtual machine.
#
# The agent works ONLY inside this container: the file tools, the shell and
# the screen all go through `podman exec`, so nothing here can reach the
# host's filesystem. A display (Xvfb) and a browser (Chromium) are included
# because the agent is expected to drive GUI programs, not just a shell.
#
# Kept deliberately small: a Debian base plus what a working desktop needs.
# Rebuild it from Settings > stella ("Reset the machine") after editing; the
# server verifies the contract values in vm/contract.ts against the running
# container at start-up.

FROM docker.io/debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

# git and tmux are part of the working environment (the agent commits and
# runs long jobs); the X stack is what a GUI program needs to exist at all.
#
# `xclip` is how the chat's screen pane hands text across to this machine:
# while the user drives the screen the text they copied travels through the
# server and is written onto the X CLIPBOARD selection here. The VNC connection
# cannot carry it — x11vnc speaks the standard RFB cut text, which is ISO
# 8859-1, so a Japanese message would arrive as question marks.
#
# `at-spi2-core` and `libglib2.0-bin` are the accessibility stack: the agent
# reads and drives a program's widgets through AT-SPI (vm_find / vm_do)
# instead of guessing at pixels. `libglib2.0-bin` carries `gsettings`, which
# entry.sh uses to switch accessibility on for every app it launches;
# `python3-pyatspi` is the client the in-machine helper is written against.
# Without these an app is invisible to the agent's semantic tools, so they
# are part of the contract (vm/contract.ts) rather than an optional extra.
RUN apt-get update && apt-get install -y --no-install-recommends \
      xvfb x11-utils x11vnc openbox xdotool scrot xclip imagemagick \
      websockify \
      xterm fonts-noto-cjk dbus-x11 \
      at-spi2-core libglib2.0-bin python3-pyatspi \
      chromium \
      curl ca-certificates gnupg \
      git tmux ripgrep less \
      sudo \
 && rm -rf /var/lib/apt/lists/*

# The GitHub CLI, from the official apt repository.
#
# `git` is in the base install; `gh` is what makes a repository usable without
# a browser — cloning a private one, opening a pull request, reading an issue.
# Debian's own package is not shipped in a usable version, and the official
# repository is the upstream's own, signed by its key (which is written to a
# path apt reads, so the repository stays trusted on later `apt-get update`
# runs inside the machine).
RUN set -eu; \
    mkdir -p /etc/apt/keyrings; \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /etc/apt/keyrings/githubcli-archive-keyring.gpg; \
    chmod 0644 /etc/apt/keyrings/githubcli-archive-keyring.gpg; \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends gh; \
    rm -rf /var/lib/apt/lists/*

# Node.js, from the official build: the Debian package is older than what
# most current tooling requires, and adding a third-party apt repository is a
# maintenance burden this image does not need.
RUN set -eu; \
    case "$(dpkg --print-architecture)" in \
      amd64) node_arch=x64 ;; \
      arm64) node_arch=arm64 ;; \
      *) echo "no Node.js build for $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/node.tar.gz \
      "https://nodejs.org/dist/v24.22.0/node-v24.22.0-linux-${node_arch}.tar.gz"; \
    tar -xzf /tmp/node.tar.gz -C /usr/local --strip-components=1; \
    rm /tmp/node.tar.gz

# The account the agent's processes run as. Not root by default: Chromium
# refuses to use its sandbox as root, and files written here must be the
# agent's own. Root is one `sudo` away (see below) rather than the default.
#
# The uid/gid match vm/contract.ts, which starts the container with
# --userns keep-id so they map onto the host user. Debian's base image has no
# group 1000, so one is created with the user (`--user-group`); naming an
# existing group here fails the build.
RUN useradd --create-home --uid 1000 --user-group --shell /bin/bash agent

# The agent may become root inside this machine: `sudo` with no password.
#
# The machine is the agent's own computer, and installing a package, enabling
# a service or editing a file under /etc is ordinary work there. Refusing it
# would only push the agent towards container-wide workarounds it cannot
# explain. Nothing outside the container is reachable from that root: the
# container has no host mount, its own capabilities are the container's (a
# rootless podman's `mount` still fails), and uid 0 inside maps to the
# unprivileged host user through `--userns keep-id`. The rule is written
# against the user's NAME (the file applies to the account, not to a uid),
# and `visudo --check` makes a malformed file fail the build instead of
# producing an image whose sudo silently does nothing.
RUN printf 'agent ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/agent \
 && chmod 0440 /etc/sudoers.d/agent \
 && visudo --check --file=/etc/sudoers.d/agent

COPY entry.sh /usr/local/bin/entry.sh
RUN chmod 0755 /usr/local/bin/entry.sh

# The accessibility helper the semantic tools (`vm_find` / `vm_do` / `vm_wait`)
# run inside the machine. Copied into the image rather than shipped as text on
# every call: it is a program of a few hundred lines, and `podman exec` starts
# a process per tool call.
#
# It sits beside this file, not in a subdirectory: the update reader a running
# server already carries accepts package entries at most one directory deep
# (the `stella-container/` the container files ship in), and a package it
# cannot read is one it cannot install.
COPY a11y.py /usr/local/lib/lumisca/a11y.py
RUN chmod 0644 /usr/local/lib/lumisca/a11y.py

# xdotool, scrot and Chromium read DISPLAY from the environment; entry.sh's
# export does not reach `podman exec`.
ENV DISPLAY=:99

# The session bus the semantic tools talk to. entry.sh starts it at exactly
# this path and switches accessibility on; the accessibility bus itself is
# found through it (org.a11y.Bus), so nothing else needs to be named. A
# `podman exec` from the server inherits none of entry.sh's exports, so the
# address is repeated here (and in vm/contract.ts, which is verified against
# the running container).
ENV DBUS_SESSION_BUS_ADDRESS=unix:path=/tmp/lumisca-dbus/session.sock

USER agent
WORKDIR /home/agent

CMD ["/usr/local/bin/entry.sh"]
